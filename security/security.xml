<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_material" model="ir.module.category">
            <field name="name">Material</field>
            <field name="sequence">5</field>
        </record>

        <record id="groups_privilege_material_request" model="res.groups.privilege">
            <field name="name">Material Request</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_material"/>
        </record>

        <record id="group_material_user" model="res.groups">
            <field name="name">Material Users</field>
            <field name="privilege_id" ref="groups_privilege_material_request"/>
            <field name="comment">Only Requisition Users can create the requests.</field>
        </record>

        <record id="group_material_manager" model="res.groups">
            <field name="name">Managers</field>
            <field name="privilege_id" ref="groups_privilege_material_request"/>
            <field name="comment">Material manager approve to head.</field>
        </record>

        <record id="group_material_head" model="res.groups">
            <field name="name">Requisition Head</field>
            <field name="privilege_id" ref="groups_privilege_material_request"/>
            <field name="comment">Requisition Head approves after the manager</field>
        </record>
    </data>
</odoo>